opam-version: "2.0"
synopsis: "Small in-process workflow observation runtime for OCaml"
description:
  "workflow-runtime tracks in-process workflow lifecycle state by durable workflow id, tenant, kind, subject, and metadata, with structured and JSON snapshots."
maintainer: ["OlegHQ"]
authors: ["OlegHQ"]
license: "MIT"
homepage: "https://github.com/OlegHQ/workflow-runtime"
bug-reports: "https://github.com/OlegHQ/workflow-runtime/issues"
depends: [
  "ocaml" {>= "5.2.0"}
  "dune" {>= "3.22" & >= "3.22"}
  "yojson"
  "base-threads"
  "alcotest" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
x-maintenance-intent: ["(latest)"]
