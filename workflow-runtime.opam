opam-version: "2.0"
synopsis: "Durable backend-backed workflow runtime for OCaml"
description:
  "workflow-runtime tracks durable workflow lifecycle state, worker claims, leases, replay history, timers, retries, updates, child workflows, and backend-backed execution for OCaml services."
maintainer: ["OlegHQ"]
authors: ["OlegHQ"]
license: "MIT"
homepage: "https://github.com/OlegHQ/workflow-runtime"
bug-reports: "https://github.com/OlegHQ/workflow-runtime/issues"
depends: [
  "ocaml" {>= "5.2.0"}
  "dune" {>= "3.22" & >= "3.22"}
  "yojson"
  "base-threads"
  "bson"
  "mongo"
  "eio"
  "eio_main"
  "mirage-crypto-rng"
  "alcotest" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
x-maintenance-intent: ["(latest)"]
